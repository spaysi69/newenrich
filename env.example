# Required: get this from your ColdIQ dashboard
COLDIQ_API_KEY=replace_with_your_coldiq_api_key

# Required: choose a password to open your hosted app
APP_PASSWORD=choose_a_long_unique_password

# Required in production; use a long random string
SESSION_SECRET=replace_with_a_long_random_secret

# Leave false for local development; Render config sets this to true
COOKIE_SECURE=false
